import Mathlib.Algebra.BigOperators.Group.List.Basic
import Mathlib.RingTheory.Norm.Transitivity
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# The basic identity of cyclic algebras, (30.3)(iii)

In `A = (L/K, σ, a) = ⊕ L u^j` with `u x = σ(x) u` (30.1), the proof of
(30.3)(iii) uses `(c u)^n = c σ(c) ⋯ σ^{n-1}(c) u^n = (N_{L/K} c) a`.

* `pow_mul_eq_iterate_mul_pow`: in any monoid, if `u x = σ(x) u` for all `x`
  in a set `S` stable under `σ`, then `u^n x = σ^n(x) u^n`.
* `mul_pow_eq_prod_iterate`: `(c u)^n = c σ(c) ⋯ σ^{n-1}(c) u^n`, the
  product taken in this order (no commutativity is assumed).
* `prod_pow_eq_norm`: for a finite Galois extension `L/K` whose group is
  generated by `σ` (of order `n`), `∏_{j<n} σ^j(c) = N_{L/K}(c)`.
-/

namespace ReinerMaximalOrders.CyclicAlgebra

section Monoid

variable {A : Type*} [Monoid A] (σ : A → A) (u : A) (S : Set A)

theorem pow_mul_eq_iterate_mul_pow (hS : ∀ x ∈ S, σ x ∈ S)
    (hu : ∀ x ∈ S, u * x = σ x * u) (n : ℕ) :
    ∀ x ∈ S, u ^ n * x = σ^[n] x * u ^ n := by
  induction n with
  | zero => intro x _; simp
  | succ n ih =>
    intro x hx
    rw [pow_succ, mul_assoc, hu x hx, ← mul_assoc, ih (σ x) (hS x hx),
      Function.iterate_succ_apply, mul_assoc]

theorem mul_pow_eq_prod_iterate (hS : ∀ x ∈ S, σ x ∈ S)
    (hu : ∀ x ∈ S, u * x = σ x * u) (c : A) (hc : c ∈ S) (n : ℕ) :
    (c * u) ^ n = ((List.range n).map (fun j => σ^[j] c)).prod * u ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, ih, List.range_succ, List.map_append, List.prod_append,
      List.map_singleton, List.prod_singleton, mul_assoc, ← mul_assoc (u ^ n),
      pow_mul_eq_iterate_mul_pow σ u S hS hu n c hc, pow_succ]
    simp only [mul_assoc]

end Monoid

section Galois

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
  [IsGalois K L]

/-- For a cyclic Galois extension with generator `σ`,
`N_{L/K}(c) = ∏_{j < ord σ} σ^j(c)`. -/
theorem prod_pow_eq_norm (σ : Gal(L/K)) (hσ : ∀ τ : Gal(L/K), τ ∈ Subgroup.zpowers σ)
    (c : L) :
    ∏ j ∈ Finset.range (orderOf σ), (σ ^ j) c = algebraMap K L (Algebra.norm K c) := by
  classical
  rw [Algebra.norm_eq_prod_automorphisms, ← IsCyclic.image_range_orderOf hσ,
    Finset.prod_image]
  intro i hi j hj hij
  exact pow_injOn_Iio_orderOf (Finset.mem_range.mp hi) (Finset.mem_range.mp hj) hij

end Galois

end ReinerMaximalOrders.CyclicAlgebra

