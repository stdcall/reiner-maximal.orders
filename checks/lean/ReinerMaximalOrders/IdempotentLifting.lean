import Mathlib.Tactic.NoncommRing
import Mathlib.RingTheory.Ideal.Operations

/-!
# The idempotent iteration in (6.7) and (6.18)

Proof of (6.7): with `n₁ = x² - x` and `x₁ = x + n₁ - 2 x n₁`, "direct
calculation gives `x₁² - x₁ = 4 n₁³ - 3 n₁²`", so `n₂ = x₁² - x₁` has `n₁²` as
a factor.  The proof of (6.18) iterates `x_(i+1) = x_i + n_i - 2 x_i n_i`,
`n_(i+1) = x_(i+1)² - x_(i+1)`, and uses `n_i ∈ N^(2^i)` for `n_1 ∈ N`.

The identity holds in every ring (the elements `x`, `n₁`, `x₁` are
polynomials in `x`, hence commute).  The membership statement is proved for
an ideal of a commutative ring; it is what the proof uses inside the
commutative subring `Z[x]` generated by `x_1`, for the ideal of that subring
generated by `n_1`.  The convergence of `{x_i}` in the `N`-adic topology and
the existence of the limit are not formalized.
-/

namespace ReinerMaximalOrders.IdempotentLifting

/-- The identity of the proof of (6.7), in an arbitrary ring. -/
theorem step_identity {A : Type*} [Ring A] (x : A) :
    let n := x * x - x
    let x₁ := x + n - 2 * x * n
    x₁ * x₁ - x₁ = 4 * (n * n * n) - 3 * (n * n) := by
  intro n x₁
  simp only [n, x₁]
  noncomm_ring

/-- The same identity in factored form: `n₂ = n₁² (4 n₁ - 3)`. -/
theorem step_factor {A : Type*} [Ring A] (x : A) :
    let n := x * x - x
    let x₁ := x + n - 2 * x * n
    x₁ * x₁ - x₁ = n * n * (4 * n - 3) := by
  intro n x₁
  simp only [n, x₁]
  noncomm_ring

/-- The iterated elements of (6.18). -/
def iter {A : Type*} [Ring A] (x : A) : ℕ → A
  | 0 => x
  | k + 1 => let y := iter x k; y + (y * y - y) - 2 * y * (y * y - y)

/-- If `x² - x ∈ N`, then `x_k² - x_k ∈ N^(2^k)` for every `k` (indexing
from `x_0 = x`, so the book's `n_i` is our `k = i - 1`). -/
theorem iter_mem {A : Type*} [CommRing A] (N : Ideal A) (x : A)
    (hx : x * x - x ∈ N) (k : ℕ) :
    iter x k * iter x k - iter x k ∈ N ^ (2 ^ k) := by
  induction k with
  | zero => simpa [iter] using hx
  | succ k ih =>
    have h := step_factor (iter x k)
    simp only at h
    show (iter x (k + 1)) * (iter x (k + 1)) - iter x (k + 1) ∈ N ^ (2 ^ (k + 1))
    simp only [iter]
    rw [h, pow_succ, pow_mul, sq]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_mul ih ih)

/-- Each step changes `x_k` by a multiple of `n_k`: `x_(k+1) - x_k ∈ N^(2^k)`,
so the sequence is Cauchy in the `N`-adic topology. -/
theorem iter_succ_sub_mem {A : Type*} [CommRing A] (N : Ideal A) (x : A)
    (hx : x * x - x ∈ N) (k : ℕ) :
    iter x (k + 1) - iter x k ∈ N ^ (2 ^ k) := by
  have h := iter_mem N x hx k
  have : iter x (k + 1) - iter x k
      = (iter x k * iter x k - iter x k) * (1 - 2 * iter x k) := by
    simp only [iter]; ring
  rw [this]
  exact Ideal.mul_mem_right _ _ h

end ReinerMaximalOrders.IdempotentLifting

