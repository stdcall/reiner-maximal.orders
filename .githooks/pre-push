#!/usr/bin/env bash
# Refuse a direct push to main: changes go through a branch and a pull
# request, merged by squash after the checks have passed. GitHub protects
# main as well; this hook catches the mistake before it reaches the server.
# Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
set -euo pipefail

python3 -c 'import json; import sys; sys.exit(0 if json.load(open("config/project.json"))["stage"] == "final" else "Push refused: the complete edition must pass final checks first.")'

protected='refs/heads/main'
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "Direct pushes to main are refused: push a branch and open a pull request." >&2
    echo "Merge it after the check job of the workflow \"PDF and checks\" pass." >&2
    exit 1
  fi
done
exit 0
